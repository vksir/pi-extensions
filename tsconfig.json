{
  // 只做类型检查（`npx tsc -p tsconfig.json`），不参与构建：扩展由 pi 运行时直接加载 .ts。
  //
  // paths 把 `@earendil-works/pi-ai` 指向 pi 的扩展视图，和运行时一致：pi 的 loader 会把扩展里的
  // 这个模块解析成「pi-ai/compat + TypeBox 的 Type / Static / TSchema + TypeBox 版 StringEnum」。
  // 不映射的话，本地 node_modules 里 pi-ai 主入口的 `StringEnum` 返回 pi-schema 的 Schema，
  // 塞进 `Type.Object` 后 Static 推断塌成 unknown，renderCall 的 args 就全成了 unknown。
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@earendil-works/pi-ai": [
        "./node_modules/@earendil-works/pi-coding-agent/dist/core/extensions/pi-ai-extension-view.d.ts"
      ]
    }
  },
  "include": ["extensions/**/*.ts", "tests/**/*.ts"]
}
